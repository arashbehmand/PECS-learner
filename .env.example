# =============================================================================
# PECS Learning System - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# The app will use these environment variables for configuration
#
# Quick Start:
#   1. Copy: cp .env.example .env
#   2. Set at least one API key (OpenAI, Anthropic, or Google)
#   3. Optionally customize model and context settings
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider API Keys (Required - choose at least one)
# -----------------------------------------------------------------------------
# OpenAI (default provider)
OPENAI_API_KEY=sk-...

# Anthropic Claude (alternative provider)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (alternative provider)
# GEMINI_API_KEY=...

# Other providers supported via LiteLLM - see: https://docs.litellm.ai/docs/providers
# Examples: Azure OpenAI, Cohere, Replicate, Hugging Face, etc.

# -----------------------------------------------------------------------------
# LLM Model Configuration (Optional - defaults provided)
# -----------------------------------------------------------------------------
# Fast model for rolling context generation (cheap/quick tasks)
# Default: gpt-5-mini
LLM_MODEL_FAST=gpt-5-mini

# Quality model for study notes generation (high-quality tasks)
# Default: gpt-5.1
LLM_MODEL_QUALITY=gpt-5.1

# Default model for general PECS feedback
# Default: gpt-5-mini
LLM_MODEL_DEFAULT=gpt-5-mini

# Example configurations for other providers:
# For Anthropic:
#   LLM_MODEL_FAST=claude-3-haiku
#   LLM_MODEL_QUALITY=claude-3-opus
#   LLM_MODEL_DEFAULT=claude-3-sonnet
#
# For Google:
#   LLM_MODEL_FAST=gemini-1.5-flash
#   LLM_MODEL_QUALITY=gemini-1.5-pro
#   LLM_MODEL_DEFAULT=gemini-1.5-flash

# -----------------------------------------------------------------------------
# Rolling Context Configuration (Optional - defaults provided)
# -----------------------------------------------------------------------------
# Maximum characters for rolling context (safety net, not target)
# Default: 10000
ROLLING_CONTEXT_MAX_CHARS=10000

# Target token count for rolling summaries (~4 chars per token = ~1600 chars)
# Default: 400 (approximately 300-400 words)
ROLLING_CONTEXT_TARGET_TOKENS=400

# -----------------------------------------------------------------------------
# Voice Input & Text-to-Speech (Optional)
# -----------------------------------------------------------------------------
# Voice for text-to-speech (AI reading feedback aloud)
# Options: alloy, echo, fable, onyx, nova (default), shimmer
# Default: nova (warm, engaging female voice)
TTS_VOICE=nova

# TTS model quality
# Options: tts-1 (faster, cheaper), tts-1-hd (higher quality)
# Default: tts-1
TTS_MODEL=tts-1

# Whisper model for speech-to-text
# Default: whisper-1 (most accurate)
WHISPER_MODEL=whisper-1

# -----------------------------------------------------------------------------
# Observability & Monitoring (Optional)
# -----------------------------------------------------------------------------
# Langfuse integration for LLM observability
# Get keys from: https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# LiteLLM Configuration (Optional)
# -----------------------------------------------------------------------------
# Enable verbose logging for debugging LLM calls
# Default: false
LITELLM_VERBOSE=false

# -----------------------------------------------------------------------------
# Server Configuration (Optional - defaults provided)
# -----------------------------------------------------------------------------
# Host to bind to
# Default: 0.0.0.0 (all interfaces)
HOST=0.0.0.0

# Port to run on
# Default: 8080
PORT=8080

# Enable auto-reload for development
# Default: false
RELOAD=false

# -----------------------------------------------------------------------------
# Storage Configuration (Optional - defaults provided)
# -----------------------------------------------------------------------------
# Path for NiceGUI storage (sessions, user data)
# Default: data/nicegui_storage
# NICEGUI_STORAGE_PATH=data/nicegui_storage

# -----------------------------------------------------------------------------
# Security & Authentication (Future feature - not yet implemented)
# -----------------------------------------------------------------------------
# Enable authentication (currently not implemented)
# Default: false
# ENABLE_AUTH=false

# Secret key for session management (change in production)
# Default: change-me-in-production
# SECRET_KEY=your-secure-random-string-here

# =============================================================================
# Notes:
# =============================================================================
# - All settings are optional except for at least one LLM API key
# - Commented settings show available options but use defaults if not set
# - See documentation for more details: ROLLING_CONTEXT_INTEGRATION.md
# - For production deployment, always use strong SECRET_KEY and enable HTTPS
# =============================================================================
